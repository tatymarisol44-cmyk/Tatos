# Copy to .env. Every variable maps to a field in src/orchestrator/config.py.
APP_ENV=dev

# --- LLM: any LiteLLM model id (anthropic/, openai/, gemini/, mistral/, ollama/) ---
# "fake" = offline deterministic backend, no key needed
LLM_BACKEND=litellm
LLM_MODEL=anthropic/claude-sonnet-5-5
ROUTER_MODEL=anthropic/claude-haiku-4-5-20251001
LLM_FALLBACK_MODELS=["openai/gpt-4o-mini"]
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# For a local Llama: LLM_MODEL=ollama/llama3.1 and OLLAMA_API_BASE=http://localhost:11434

# --- Retrieval ---
# "litellm" + EMBEDDING_MODEL for semantic/multilingual routing
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=openai/text-embedding-3-small
# "qdrant" in docker-compose / k8s
VECTOR_BACKEND=memory
QDRANT_URL=http://localhost:6333

# --- Routing ---
ROUTER_USE_LLM=true
ROUTER_TOP_K=8
ROUTER_MIN_CONFIDENCE=0.35

# --- Team mode (planner -> parallel specialists -> synthesizer) ---
PLANNER_MODEL=anthropic/claude-sonnet-5-5
TEAM_MAX_AGENTS=4
TEAM_CANDIDATES_K=16
TEAM_MAX_CONCURRENCY=4

# --- Company knowledge base (RAG) ---
KNOWLEDGE_ENABLED=true
KNOWLEDGE_TOP_K=4
# Raise to ~0.3 with semantic embeddings (EMBEDDING_BACKEND=litellm)
KNOWLEDGE_MIN_SCORE=0.1

# --- Remote A2A agents (Java/.NET/... specialists) ---
# JSON list of base URLs serving /.well-known/agent-card.json
# REMOTE_AGENTS=["http://localhost:8080"]
# REMOTE_AGENTS_API_KEY=
# Send tenant documents (RAG context) to remote agents? Off: they stay in our boundary.
REMOTE_SHARE_KNOWLEDGE=false
# Java agent LLM mode (docker compose): none | anthropic
AGENT_LLM_PROVIDER=none

# --- Answer-quality evals (LLM-as-judge) ---
# Stronger than LLM_MODEL, ideally another provider family (avoids self-preference)
JUDGE_MODEL=anthropic/claude-opus-5-5
JUDGE_MIN_SCORE=4

# --- Conversation state ---
# "postgres" keeps threads across restarts and shares them between replicas
CHECKPOINTER_BACKEND=memory
# POSTGRES_URL=postgresql://agency:agency@localhost:5432/agency
POSTGRES_POOL_SIZE=10

# --- API ---
# Comma-separated key:tenant pairs. Leave empty in dev for anonymous access (refused in prod).
API_KEYS=
RATE_LIMIT_PER_MINUTE=60

# --- Observability ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LITELLM_LOCAL_MODEL_COST_MAP=True
