# Copy to .env. Every variable maps to a field in src/orchestrator/config.py.
APP_ENV=dev

# --- LLM: any LiteLLM model id (anthropic/, openai/, gemini/, mistral/, ollama/) ---
# "fake" = offline deterministic backend, no key needed
LLM_BACKEND=litellm
LLM_MODEL=anthropic/claude-sonnet-5-5
ROUTER_MODEL=anthropic/claude-haiku-4-5-20251001
LLM_FALLBACK_MODELS=["openai/gpt-4o-mini"]
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# For a local Llama: LLM_MODEL=ollama/llama3.1 and OLLAMA_API_BASE=http://localhost:11434

# --- Retrieval ---
# "litellm" + EMBEDDING_MODEL for semantic/multilingual routing
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=openai/text-embedding-3-small
# "qdrant" in docker-compose / k8s
VECTOR_BACKEND=memory
QDRANT_URL=http://localhost:6333

# --- Routing ---
ROUTER_USE_LLM=true
ROUTER_TOP_K=8
ROUTER_MIN_CONFIDENCE=0.35

# --- Team mode (planner -> parallel specialists -> synthesizer) ---
PLANNER_MODEL=anthropic/claude-sonnet-5-5
TEAM_MAX_AGENTS=4
TEAM_CANDIDATES_K=16
TEAM_MAX_CONCURRENCY=4

# --- Company knowledge base (RAG) ---
KNOWLEDGE_ENABLED=true
KNOWLEDGE_TOP_K=4
# Raise to ~0.3 with semantic embeddings (EMBEDDING_BACKEND=litellm)
KNOWLEDGE_MIN_SCORE=0.1
# Evidence gating: best chunk >= this is "strong" (~0.5 with semantic embeddings)
KNOWLEDGE_STRONG_SCORE=0.25
# Retrieval attempts per turn (the retry rewrites a follow-up with the previous turn)
KNOWLEDGE_MAX_ATTEMPTS=2
# Regenerations of an answer that cites sources that do not exist
CITATION_MAX_RETRIES=1

# --- Governance / ERM: audit trail, human review, consents, CRM, campaigns ---
# SQLAlchemy async URL. Default: SQLite in memory (dev only). Prod: Postgres with TLS, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/agency?sslmode=require
# Industry pack per tenant (JSON): general | dental | retail | ec-psychologist | ec-psychiatrist
TENANT_PACKS={}
DEFAULT_PACK=general
# Hold high-risk answers for a human (clinical advice, reviewed divisions, flagged injection)
REVIEW_ENABLED=true

# --- Semantic memory (per data subject; needs the subject's `memory` consent) ---
MEMORY_ENABLED=true
MEMORY_TTL_DAYS=365
MEMORY_MIN_SCORE=0.15

# --- Campaigns ---
# Without a token the Telegram channel runs dry (messages are recorded, not sent)
# TELEGRAM_BOT_TOKEN=
CAMPAIGN_DEFAULT_HOLDOUT_PCT=20
CAMPAIGN_CONVERSION_WINDOW_DAYS=30

# --- Social channels and publishing (ADR 0015) ---
# Each connected account names its credential (secret_ref); the token itself goes here as
# SOCIAL_SECRET_<secret_ref>. Without it, publishing runs dry.
# SOCIAL_SECRET_IG_DR_DEMO=
# Creatives: ffmpeg renders the videos (a name on PATH or a full path).
# FFMPEG_BINARY=ffmpeg
# Where rendered creatives live. Without GCS_BUCKET they stay here and live Instagram
# publishing is refused (Instagram needs a URL it can fetch).
MEDIA_DIR=media
# GCS_BUCKET=
MEDIA_URL_TTL_MINUTES=60
# Pin a Graph API version once the Meta app exists, e.g. https://graph.facebook.com/vNN.0
# META_GRAPH_BASE=https://graph.instagram.com
# WhatsApp webhook: both are needed, or the endpoint does not exist.
# WHATSAPP_VERIFY_TOKEN=
# META_APP_SECRET=

# --- On-call alerts (ADR 0017): Telegram (bot above), WhatsApp template, e-mail ---
ALERT_ESCALATION_MINUTES=5
# Approved WhatsApp template with one body parameter (the alert reference); unset = skipped
# WHATSAPP_ALERT_TEMPLATE=
# WHATSAPP_ALERT_TEMPLATE_LANGUAGE=es
# SMTP over STARTTLS; unset SMTP_HOST = e-mail notices run dry
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Remote A2A agents (Java/.NET/... specialists) ---
# JSON list of base URLs serving /.well-known/agent-card.json
# REMOTE_AGENTS=["http://localhost:8080"]
# REMOTE_AGENTS_API_KEY=
# Send tenant documents (RAG context) to remote agents? Off: they stay in our boundary.
REMOTE_SHARE_KNOWLEDGE=false
# Java agent LLM mode (docker compose): none | anthropic
AGENT_LLM_PROVIDER=none

# --- Answer-quality evals (LLM-as-judge) ---
# Stronger than LLM_MODEL, ideally another provider family (avoids self-preference)
JUDGE_MODEL=anthropic/claude-opus-5-5
JUDGE_MIN_SCORE=4

# --- Conversation state ---
# "postgres" keeps threads across restarts and shares them between replicas
CHECKPOINTER_BACKEND=memory
# POSTGRES_URL=postgresql://agency:agency@localhost:5432/agency
POSTGRES_POOL_SIZE=10

# --- API ---
# Comma-separated key:tenant pairs. Leave empty in dev for anonymous access (refused in prod).
API_KEYS=
RATE_LIMIT_PER_MINUTE=60

# --- Observability ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LITELLM_LOCAL_MODEL_COST_MAP=True
